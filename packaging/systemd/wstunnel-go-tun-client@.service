[Unit]
Description=wstunnel-go tun client - %I
Documentation=https://github.com/kad/wstunnel-go/blob/main/docs/TUN.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/wstunnel-go --config /etc/wstunnel-go/%i.yaml client
Restart=always
RestartSec=5
# Creating the tun device, its addresses and its routes needs CAP_NET_ADMIN.
# So does a full tunnel (route=default): the policy rules and routes go over
# netlink, and marking the client's own sockets (SO_MARK) needs it too; nothing
# else is required for those. dns= runs resolvectl, which systemd-resolved's
# polkit policy may refuse to a service with only this capability: that depends
# on the host and is not verified here (see docs/TUN.md).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
# Security Hardening
ReadOnlyPaths=/etc/wstunnel-go
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
